{
  "headers": [
    { "source": "/*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=600, s-maxage=86400" }] },
    { "source": "/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/*.css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, s-maxage=31536000, immutable" }] },
    { "source": "/*.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, s-maxage=31536000, immutable" }] },
    { "source": "/*.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, s-maxage=600" }] },
    { "source": "/data/*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=600, s-maxage=600" }] },
    { "source": "/fonts/*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, s-maxage=2592000" }, { "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/picture/*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, s-maxage=2592000" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/api/*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/login/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/auctions/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/quant/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/css/*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, s-maxage=31536000, immutable" }] },
    { "source": "/js/*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, s-maxage=31536000, immutable" }] }
  ]
}
